# ==============================================================================
# SysCore - Server Management System Environment Configuration
# ==============================================================================
# HINWEIS: Kopiere diese Datei nach .env und passe die Werte an deine Umgebung an.
# Die .env Datei wird von Git ignoriert und enthält sensible Zugangsdaten.

# --- Sicherheit & Flask Secret ---
# Erzeuge einen sicheren 64-stelligen Key z.B. via: python3 -c "import secrets; print(secrets.token_hex(32))"
SYSCORE_SECRET_KEY=change_me_to_a_very_secure_random_string_in_production

# --- Netzwerk & Server-Daemon ---
SYSCORE_HOST=0.0.0.0
SYSCORE_PORT=8888
SYSCORE_DEBUG=false

# --- Initialer Admin-Account (wird beim ersten Start in syscore.db angelegt) ---
SYSCORE_ADMIN_USER=admin
SYSCORE_ADMIN_PASS=ChangeMeImmediately123!
SYSCORE_ADMIN_EMAIL=admin@example.com

# --- Pfade & Systemintegration ---
SYSCORE_DB_PATH=syscore.db
SYSCORE_WEB_ROOT_BASE=/var/www
SYSCORE_NGINX_AVAILABLE=/etc/nginx/sites-available
SYSCORE_NGINX_ENABLED=/etc/nginx/sites-enabled
SYSCORE_APACHE_PORTS_CONF=/etc/apache2/ports.conf
SYSCORE_BACKUP_DIR=/var/backups/syscore

# --- Optional: Let's Encrypt Standard E-Mail ---
SYSCORE_CERTBOT_EMAIL=admin@example.com
